# --- 1. Firebase Authentication & Cloud Firestore ---
# Obtain from Firebase Console -> Project Settings -> General -> Your Apps (Web App)
VITE_FIREBASE_API_KEY=AIzaSyA_YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- 2. SentinelGrid OS Guardian Backend ---
VITE_API_URL=http://localhost:8000

# --- 3. Google Gemini AI Device Guardian ---
VITE_GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

